{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owcs.example/schema/player-state-v1.schema.json",
  "title": "OWCS OB Analyzer player state snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "session_id",
    "sequence",
    "observed_at",
    "source_age_ms",
    "source_status",
    "hud",
    "source",
    "players"
  ],
  "properties": {
    "type": { "const": "state.snapshot" },
    "schema_version": { "const": "1.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "source_age_ms": { "type": "integer", "minimum": 0 },
    "source_status": {
      "enum": ["waiting", "online", "stale", "stopped", "error"]
    },
    "hud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "offset_y_px", "confidence"],
      "properties": {
        "status": { "enum": ["searching", "locked"] },
        "offset_y_px": { "type": ["integer", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "capture_fps", "cycle_latency_ms"],
      "properties": {
        "name": { "type": "string" },
        "capture_fps": { "type": "number", "minimum": 0 },
        "cycle_latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "players": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/player" }
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "side",
        "slot",
        "display_name",
        "display_name_status",
        "display_name_confidence",
        "hero",
        "life_state",
        "hero_status",
        "life_status",
        "hero_confidence",
        "life_confidence",
        "updated_at"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^(left|right)-[1-5]$"
        },
        "side": { "enum": ["left", "right"] },
        "slot": { "type": "integer", "minimum": 1, "maximum": 5 },
        "display_name": { "type": ["string", "null"] },
        "display_name_status": { "enum": ["confirmed", "unknown"] },
        "display_name_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hero": { "type": ["string", "null"] },
        "life_state": { "enum": ["alive", "dead", "unknown"] },
        "hero_status": { "enum": ["confirmed", "unknown"] },
        "life_status": { "enum": ["confirmed", "unknown"] },
        "hero_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "life_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
