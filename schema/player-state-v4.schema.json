{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OWCS player state v4",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "status": {
      "enum": [
        "online",
        "delayed",
        "stale",
        "stopped",
        "waiting",
        "error"
      ]
    },
    "panel_visible": {
      "type": "boolean"
    },
    "stream_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "players": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "hero": {
            "type": [
              "string",
              "null"
            ]
          },
          "hero_selection": {
            "enum": [
              "selected",
              "unselected",
              null
            ]
          },
          "life_state": {
            "enum": [
              "alive",
              "dead",
              null
            ]
          },
          "ultimate_charge": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "ultimate_ready": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "respawn_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "stats": {
            "type": "object",
            "properties": {
              "eliminations": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "assists": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "deaths": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "damage": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "healing": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "mitigated": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "eliminations",
              "assists",
              "deaths",
              "damage",
              "healing",
              "mitigated"
            ],
            "additionalProperties": false
          },
          "perks": {
            "type": "object",
            "properties": {
              "minor": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "selection": {
                    "enum": [
                      "selected",
                      "unselected",
                      "not_shown"
                    ]
                  },
                  "name_zhCN": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "selection"
                ],
                "additionalProperties": false
              },
              "major": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "selection": {
                    "enum": [
                      "selected",
                      "unselected",
                      "not_shown"
                    ]
                  },
                  "name_zhCN": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "selection"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "minor",
              "major"
            ],
            "additionalProperties": false
          },
          "stale_fields": {
            "type": "array",
            "items": {
              "enum": [
                "display_name",
                "hero",
                "hero_selection",
                "life_state",
                "respawn_seconds",
                "ultimate_charge",
                "ultimate_ready",
                "perks.minor",
                "perks.major",
                "stats.eliminations",
                "stats.assists",
                "stats.deaths",
                "stats.damage",
                "stats.healing",
                "stats.mitigated"
              ]
            },
            "uniqueItems": true
          },
          "hero_name_zhCN": {
            "type": [
              "string",
              "null"
            ],
            "description": "Chinese display name; follows hero validity, null if unavailable."
          },
          "role": {
            "enum": [
              "tank",
              "damage",
              "support",
              null
            ],
            "description": "Derived from confirmed hero; follows hero validity."
          },
          "player_id": {
            "type": "string",
            "minLength": 6
          },
          "presence_status": {
            "enum": [
              "present",
              "missing",
              "unconfirmed"
            ]
          },
          "team": {
            "enum": [
              "A",
              "B",
              null
            ],
            "description": "Current confirmed scoreboard side (A upper/left, B lower/right), or last confirmed side for historical identities; null if unconfirmed. Not an organization or locked lineup."
          }
        },
        "required": [
          "display_name",
          "hero",
          "hero_selection",
          "life_state",
          "ultimate_charge",
          "ultimate_ready",
          "respawn_seconds",
          "stats",
          "perks",
          "stale_fields",
          "player_id",
          "presence_status",
          "team"
        ],
        "additionalProperties": false
      },
      "description": "One record per confirmed player identity, including retained history. Bind by player_id, never array index."
    },
    "error": {
      "type": "string"
    },
    "game_paused": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True when the supported pause banner is detected; null if panel unavailable."
    }
  },
  "required": [
    "schema_version",
    "status",
    "panel_visible",
    "players"
  ],
  "additionalProperties": false
}
